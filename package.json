{
  "name": "battledrones",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:pages": "node tools/build-pages.mjs",
    "preview": "vite preview",
    "test": "vitest run && node --test tools/pages-archive.test.mjs",
    "test:watch": "vitest",
    "smoke": "node tools/smoke.mjs",
    "maps": "vite-node tools/export-maps.ts",
    "mapgen": "vite-node tools/mapgen-preview.ts",
    "balance": "vite-node tools/balance.ts",
    "arena": "vite-node tools/arena.ts",
    "art:generate": "python3 art/generate.py",
    "art:process": "python3 art/process.py",
    "art:terrain": "python3 art/terrain.py",
    "art:textures": "python3 art/textures.py",
    "ios": "npm run build && cap sync ios && cap open ios",
    "ios:sync": "npm run build && cap sync ios"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "panache-apple-sign-in": "file:native/apple-sign-in",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/three": "^0.185.4",
    "playwright-core": "^1.61.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-node": "^2.1.9",
    "vite-plugin-pwa": "^0.21.0",
    "vitest": "^2.1.0"
  }
}
